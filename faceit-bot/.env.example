# Токен бота от @BotFather
BOT_TOKEN=123456:ABC...
# Публичный HTTPS-адрес этого сервера — его откроет Telegram как Mini App
WEBAPP_URL=https://your-domain.com
PORT=8080
# Секрет для webhook (любая длинная случайная строка)
WEBHOOK_SECRET=
# Твой Telegram ID (узнать: команда /id в боте). Несколько — через запятую
ADMIN_IDS=
# ID группы с друзьями для уведомлений о лобби (добавь бота в группу и напиши /id). Необязательно
NOTIFY_CHAT_ID=
# Список карт через запятую
MAPS=Sandstone,Rust,Province,Zone 7,Dune,Breeze,Hanami,Sakura
